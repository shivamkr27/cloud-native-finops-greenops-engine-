# Optional Electricity Maps integration
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_ZONE=US-CA

# Carbon-aware scheduling defaults
CARBON_THRESHOLD=150
MIN_REPLICAS=1
MAX_REPLICAS=5
TARGET_DEPLOYMENT=batch-processor
TARGET_NAMESPACE=default

# Kubernetes dashboard mock API used for local Minikube demos
GRID_API_URL=http://greenops-dashboard.default.svc.cluster.local/api/carbon-intensity